{
  "name": "adventures-of-pingo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx tools/build-sw.ts",
    "build:demo": "tsc --noEmit && tsx tools/build-pacote.ts demo",
    "build:itch": "tsc --noEmit && tsx tools/build-pacote.ts itch",
    "build:itch:completo": "tsc --noEmit && tsx tools/build-pacote.ts itch-completo",
    "preview": "vite preview",
    "assets": "tsx tools/render-all.ts",
    "bake": "tsx tools/bake-maps.ts",
    "check": "tsx tools/verify.ts",
    "test": "tsx tools/test-batalha.ts && tsx tools/verify/save.ts",
    "test:save": "tsx tools/verify/save.ts",
    "desktop": "npm run build && electron-builder --dir --config plataformas/desktop/electron-builder.yml",
    "desktop:pacotes": "npm run build && electron-builder --linux AppImage --win portable nsis --x64 --config plataformas/desktop/electron-builder.yml",
    "desktop:mac": "npm run build && electron-builder --mac --config plataformas/desktop/electron-builder.yml",
    "desktop:abrir": "electron plataformas/desktop/main.cjs",
    "test:desktop": "tsx tools/verify/desktop.ts",
    "ios": "npm run build && npx cap sync ios",
    "android": "npm run build && npx cap sync android",
    "android:apk": "npm run android && cd plataformas/android && ./gradlew assembleRelease",
    "test:offline": "tsx tools/verify/offline.ts",
    "icones": "tsx tools/build-icones.ts",
    "test:atualizacao": "tsx tools/verify/atualizacao.ts",
    "i18n:extrair": "tsx tools/i18n/extrair.ts",
    "i18n:faltando": "tsx tools/i18n/faltando.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.1",
    "esbuild": "^0.24.0",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3"
  }
}
