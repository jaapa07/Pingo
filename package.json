{
  "name": "adventures-of-pingo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsx tools/build-sw.ts",
    "preview": "vite preview",
    "assets": "tsx tools/render-all.ts",
    "bake": "tsx tools/bake-maps.ts",
    "check": "tsx tools/verify.ts",
    "test": "tsx tools/test-batalha.ts",
    "desktop": "npm run build && electron-builder --dir --config plataformas/desktop/electron-builder.yml",
    "ios": "npm run build && npx cap sync ios"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.1",
    "esbuild": "^0.24.0",
    "three": "^0.170.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3"
  }
}
